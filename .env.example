# --- Auto-Coder Swarm 설정값 예시 ---
# 표와 설명은 DEPLOYMENT.md 의 "설정값" 을 본다.

# 1. 열쇠
SWARM_API_KEY=your_secret_key_here
# 없으면 CIE 가 401 을 주고 값 추가 흐름이 통째로 선다.
CIE_API_KEY=
CKH_API_KEY=

# 2. 주소
LISTEN_ADDR=:8006
ORACLE_URL=http://localhost:8005
CKH_URL=http://localhost:8007
NATS_URL=nats://localhost:4222
REDIS_ADDR=localhost:6379
AMQP_URL=amqp://guest:guest@localhost:5672/
SLACK_WEBHOOK_URL=

# 3. 모델
# 주면 큐를 거치지 않고 이 주소에 직접 묻는다.
LLM_DIRECT_URL=
LLM_API_URL=
LLM_API_KEY=
# 판정은 흔들리면 안 된다.
LLM_JUDGE_TEMPERATURE=0
# 너무 낮으면 답이 중간에 잘려 파싱이 조용히 실패한다.
LLM_MAX_TOKENS=4096

# 4. 경로
MASTER_REPOS_PATH=/home/cnf/cie-repos
WORKSPACE_BASE_PATH=/tmp
SWARM_DB_PATH=./swarm.db
TEMPLATES_PATH=./web/templates
# 주면 SQLite 대신 이 DB 를 쓴다.
DATABASE_DSN=

# 5. 문법 검사기 — 비워 두면 알아서 찾는다
DART_BIN=
TS_PARSER=
