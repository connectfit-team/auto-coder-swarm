# --- Auto-Coder Swarm Environment Configuration Example ---

# 1. Security & Authentication
# Required: API Key for submitting/approving tasks via REST API
SWARM_API_KEY=your_secret_key_here

# 2. Network & Connectivity
# Address for the Swarm API & Dashboard to listen on
LISTEN_ADDR=:8006

# URL for the Code-Insight Engine (Oracle)
ORACLE_URL=http://localhost:8005

# Slack Webhook for real-time notifications (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# 3. Path Configuration
# Absolute path to the master repositories (where clones are stored)
MASTER_REPOS_PATH=/absolute/path/to/master/repos

# Base directory for isolated worker sandboxes (Temporary)
WORKSPACE_BASE_PATH=/tmp

# Path to the SQLite database file
SWARM_DB_PATH=./swarm.db

# Path to the web templates directory
TEMPLATES_PATH=./web/templates
