  bool isTutorialSettingTarget();
}

abstract class AdvertisementController {
  AdvertisementController();

  Future<bool> show(BuildContext context);
}

/// Controller for rewarded advertisements.
/// 
/// Lifecycle Contract:
/// 1. [request](): Request and load the rewarded ad.
/// 2. [show](): Display the loaded rewarded ad to the user.
/// 3. [useRewarded](): Grant the reward to the user after the ad is successfully viewed.
abstract class AdvertisementRewardedController extends AdvertisementController {
  AdvertisementRewardedController();

  @override
  Future<bool> show(BuildContext context);

  /// Requests the rewarded ad to be loaded.
  Future<bool> request();

  Future<bool> getIsRewarded();

  /// Consumes the reward obtained from the rewarded ad.
  Future<void> useRewarded();
}

abstract class AdvertisementInterstitialController extends AdvertisementController {
  AdvertisementInterstitialController();

  Future<bool> request();
}

abstract class AdvertisementBannerController extends AdvertisementController {
  final ValueNotifier<BannerAd?> banner = ValueNotifier(null);
  bool isRequested = false;

  Future<BannerAd?> load();
  void deleteBannerAd();
}
