        .toList();
  }

  @override
  Future<List<WorkStamp>> getWorkDays({required String workPlaceID}) async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().WorkStamp().workDayListGet,
      RequestWorkDayListGet(workplaceId: workPlaceID),
    ).perform();
    if (resp.hasError) return Future.error(resp.errorText);
    final msg = resp.message!;
    final stamps = WorkDayLegacy().convertWorkDay(msg.workDays);
    stamps.addAll(WorkDayLegacy().convertWorkDayCase(msg.workDayCases));
    return stamps;
  }

  @override
  Future<List<String>> isUnSynced({required List<String> workPlaceIDs}) async {
    final List<String> unSynced = [];
    final checkResponse = await AppGrpcClient()
        .WorkStamp()
        .workDaySynchronizationCheck(
            RequestWorkDaySynchronizationCheck(workplaceIds: workPlaceIDs));
    for (var status in checkResponse.statuses) {
      if (status.synced && workPlaceIDs.contains(status.workplaceId)) continue;
      unSynced.add(status.workplaceId);
    }
    return unSynced;
  }

  /// Synchronizes local work stamps with the server using a gRPC client-to-server stream.
  /// To optimize transmission and avoid exceeding gRPC message size limits, 
  /// the data is split into chunks of 1,000 units per stream message.
  @override
  Future<void> synchronize({
    required String workPlaceID,
    required List<WorkStamp> workStamps,
  }) async {
    StreamController<RequestWorkDaySynchronize> requestStreamController =
        StreamController.broadcast(sync: false);
    const chunkSize = 1000;
    final resp = AppGrpcClient()
        .WorkStamp()
        .workDaySynchronize(requestStreamController.stream);
    requestStreamController.onListen = () {
      if (workStamps.length <= chunkSize) {
        requestStreamController.add(RequestWorkDaySynchronize(
          workplaceId: workPlaceID,
          workStamps: workStamps.map((e) => e.toProto).toList(),
        ));
      } else {
        while (workStamps.length >= chunkSize) {
          requestStreamController.add(RequestWorkDaySynchronize(
            workplaceId: workPlaceID,
            workStamps:
                workStamps.sublist(0, chunkSize).map((e) => e.toProto).toList(),
          ));
          workStamps.removeRange(0, chunkSize);
        }
        requestStreamController.add(RequestWorkDaySynchronize(
          workplaceId: workPlaceID,
          workStamps: workStamps.map((e) => e.toProto).toList(),
        ));
      }
      requestStreamController.add(RequestWorkDaySynchronize(
        workplaceId: workPlaceID,
        workStamps: [],
      ));
    };
    try {
      await AppGrpcClient().WorkStamp().workQuickDaySynchronize(
          RequestWorkQuickDaySynchronize(workplaceIds: [workPlaceID]));
    } catch (e) {}
  }

  @override
  Future<Map<String, dynamic>> getWorkLabels(
      {required String workPlaceID, Duration? timeOut}) async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().WorkStamp(timeOut: timeOut).workStampLabelListGet,
      RequestWorkStampLabelListGet(workplaceId: workPlaceID),
    ).perform();
    if (resp.hasError) return Future.error(resp.errorText);
    final msg = resp.message!;
    final labels = msg.labels.map((e) => WorkLabel.fromProto(e)).toList();
    return {
      'synced': msg.synced,
      'labels': labels,
      'workPlaceID': workPlaceID,
    };
  }

  Future<List<WorkLabel>> syncWorkLabel(
      {required String workPlaceID,
      required List<WorkLabel> labels,
      Duration? timeOut}) async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().WorkStamp(timeOut: timeOut).workStampLabelSynchronize,
      RequestWorkStampLabelSynchronize(
        workplaceId: workPlaceID,
        labels: labels
            .map((label) => RequestWorkStampLabelSynchronize_Label(
                  label: label.label,
                  createdAt: Timestamp.fromDateTime(label.createdAt),
                ))
            .toList(),
      ),
    ).perform();
    if (resp.hasError) return Future.error(resp.errorText);
    final msg = resp.message!;
    return msg.labels
        .map((e) => WorkLabel(
              workPlaceID: workPlaceID,
              label: e.label,
              createdAt: DateTimeUtil.fromDateTime(e.createdAt.toDateTime()),
            ))
        .toList();
  }

  Future<bool> workLabelDelete(
      {required String workPlaceID,
      required String label,
      Duration? timeOut}) async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().WorkStamp(timeOut: timeOut).workStampLabelDelete,
      RequestWorkStampLabelDelete(
        workplaceId: workPlaceID,
        label: label,
      ),
    ).perform();
    if (resp.hasError) return Future.error(resp.errorText);
    return true;
  }

  Future<bool> workLabelCreate(
      {required String userID,
      required WorkLabel label,
      Duration? timeOut}) async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().WorkStamp(timeOut: timeOut).workStampLabelCreate,
      RequestWorkStampLabelCreate(
        labels: label.toProto(userID),
      ),
    ).perform();
    if (resp.hasError) return Future.error(resp.errorText);
    return true;
  }
}
