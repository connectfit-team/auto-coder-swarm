  RewardedInterstitialADController rewardedInterstitialControllerByUnitID({
    required String adUnitID,
    required String transactionID,
    required String customData,
    bool forceShow = false,
  }) {
    return RewardedInterstitialADController(
      adUnitID: adUnitID,
      transactionID: transactionID,
      customData: customData,
      targetChecker: AppNotifier.instance,
      forceShow: forceShow,
    );
  }

  /// Mechanism for preventing duplicate event transmission:
  /// A set used to track transmitted events. The key is composed of "transactionID:eventName".
  /// This ensures that the same event for a specific transaction is not sent multiple times.
  final Set<String> _sentEventsByTransaction = {};

  Future<void> sendEvent({
    required String name,
    required String transactionID,
    required String adUnitID,
    Map<String, String> fields = const {},
  }) async {
    // Duplicate Event Prevention:
    // Before sending an event, we check if the specific combination of transactionID 
    // and event name already exists in the [_sentEventsByTransaction] set.
    // This prevents redundant analytics data resulting from rapid user interactions 
    // or duplicate callback triggers.
    if (transactionID.isNotEmpty) {
      final key = "$transactionID:$name";
      if (_sentEventsByTransaction.contains(key)) return;
      _sentEventsByTransaction.add(key);
    }

    final now = DateTime.now().toUtc().toIso8601String();
    final standardFields = {
      "transaction_id": transactionID,
      "user_id": AppModel.instance.user.id,
      "device_id": (await APP_DEVICE_ID).toString(),
      "language": AppModel.instance.user.locale,
      "ad_unit_id": adUnitID,
      "os": Platform.operatingSystem,
      "created_at": now,
    };

    SendEventAppAnalytics(
      name,
      eventType: EventType.noPrefix,
      tags: {
        "category": "admob",
        "version": (await APP_VERSION).toString(),
      },
      fields: {
        ...standardFields,
        ...fields,
      },
    );
  }
}
