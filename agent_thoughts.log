import 'package:flutter/services.dart';
// Project imports:
import 'package:gig/admob/advertisement.controller.dart';
import 'package:gig/api/admob.api.dart';
import 'package:gig/gig.dart';
import 'package:gig/model/app_state.dart';
import 'package:gig/model/user_property.dart';
import 'package:gig/subscription/subscription.dart';
import 'package:gig/widget/notify.dart';
import 'package:gig_mobile_proto/proto_v2/admobapis/admob/v1/proto.dart';
import 'package:google_mobile_ads/google_mobile_ads.dart';
import 'package:store_checker/store_checker.dart';
import 'package:synchronized/synchronized.dart';

part 'banner.ad.dart';
part 'interstitial.ad.dart';
part 'rewarded.ad.dart';
part 'rewarded.interstitial.ad.dart';

enum ADType {
  dailyWorkStampPopupBanner,
  caseCoupangBottomBanner,
  caseNotCoupangCenterBanner;

  bool get isCoupangNotInstalled => this == ADType.caseNotCoupangCenterBanner;

  AdSize get adSize {
    switch (this) {
      case ADType.dailyWorkStampPopupBanner:
        return AdSize.largeBanner;
      case ADType.caseCoupangBottomBanner:
        return AdSize.banner;
      case ADType.caseNotCoupangCenterBanner:
        return AdSize.mediumRectangle;
    }
  }
}

Future<bool> getDownloadedStore() async {
  Source downloadedStore;
  try {
    downloadedStore = await StoreChecker.getSource;
  } on PlatformException {
    downloadedStore = Source.UNKNOWN;
  }
  switch (downloadedStore) {
    case Source.IS_INSTALLED_FROM_APP_STORE:
      return true;
    case Source.IS_INSTALLED_FROM_PLAY_STORE:
      return true;
    default:
      if (kDebugMode) {
        await AppToast.Show(downloadedStore.toString());
      }
      if (IS_DEV) return true;
      return kDebugMode;
  }
}

/// Manages AdMob advertisements, caching of ad unit IDs, and synchronization with the server.
/// 
/// [Singleton Design Pattern]:
/// This class implements the Singleton pattern via a private internal constructor 
/// and a static [instance] getter. This ensures a single point of control for 
/// ad configurations and state across the application, preventing redundant 
/// initialization and ensuring consistency of ad data.
class AdmobManager {
  static final AdmobManager _singleton = AdmobManager._internal();
  static AdmobManager get instance => _singleton;
  AdmobManager._internal();

  final _cacheKey = "cached_admob_info_v1";

  // 리워드 서브시 이용 가능 여부
  final isRewardAvailable = ValueNotifier<bool>(false);
  // 쿠팡 광고 이용 가능 여부
  final isCoupangAvailable = ValueNotifier<bool>(false);

  // 광고 데이터
  final AdmobBannerData bannerData = AdmobBannerData();

  Future<void> init() async {
    await MobileAds.instance.initialize();

    // 개발(디버그) 모드일 때만 테스트 설정 적용
    if (kDebugMode) {
      RequestConfiguration configuration = RequestConfiguration(
        testDeviceIds: [
          'GADSimulatorID', // 모든 iOS 시뮬레이터 자동 등록!
        ],
      );
      await MobileAds.instance.updateRequestConfiguration(configuration);
      logger.d("AdMob: 테스트 기기 설정 완료 (시뮬레이터 포함)");
    }
  }

  /// [Ad ID Caching Strategy]:
  /// To avoid blocking the UI and to support offline ad availability, this method 
  /// retrieves cached AdMob configuration from [UserProperty]. The configuration 
  /// is stored as a base64 encoded string representing the binary protocol buffer 
  /// data, allowing for rapid restoration of ad unit IDs upon app startup.
  Future<void> loadAdmobInfoFromCache() async {
    if (!IS_WORKER) return;

    final property = await UserProperty.GetProperty(_cacheKey, remote: false);
    if (property != null && property.value != null) {
      try {
        final response =
            GetAdmobInfoResponse.fromBuffer(base64Decode(property.value!));
        _applyResponse(response);
      } catch (e) {
        logger.w("AdmobManager: Cache parse error.");
      }
    }
  }

  /// [Server Synchronization Flow]:
  /// 1. Requests the most recent AdMob configuration from the backend via [AdmobAPI].
  /// 2. Updates the manager's internal state and [ValueNotifier]s using [_applyResponse].
  /// 3. Serializes the binary protobuf response into a base64 encoded string and 
  ///    persists it via [UserProperty.SetProperty] to update the local cache.
  Future<void> syncAdmobInfoWithServer({
    Duration timeout = const Duration(minutes: 1),
  }) async {
    if (!IS_WORKER) return;

    try {
      final response = await AdmobAPI().getAdmobInfo(timeout: timeout);
      _applyResponse(response);

      await UserProperty.SetProperty(
        _cacheKey,
        base64Encode(response.writeToBuffer()),
      );
      logger.d("AdmobManager: Admob Info Synced");
    } catch (e) {
      logger.e("AdmobManager: Server sync failed: $e");
    }
  }

  void _applyResponse(GetAdmobInfoResponse resp) {
    isRewardAvailable.value = resp.rewardAvailable;
    isCoupangAvailable.value = resp.coupangAvailable;

    bannerData.clear();

    if (resp.hasDailyDetailBannerAd()) {
      bannerData.dailyDetailBannerAd = resp.dailyDetailBannerAd;
    }
    if (resp.hasCaseCoupangBottomBannerAd()) {
      bannerData.caseCoupangBottomBannerAd = resp.caseCoupangBottomBannerAd;
    }
    if (resp.hasCaseNotCoupangCenterBannerAd()) {
      bannerData.caseNotCoupangCenterBannerAd =
          resp.caseNotCoupangCenterBannerAd;
    }
  }

  /// 메디에이션 디버깅을 위한 애드 인스펙터 열기
  void openInspector() {
    MobileAds.instance.openAdInspector((error) {
      if (error != null) {
        logger.e("AdMob: 애드 인스펙터 실행 에러 - ${error.toString()}");
        AppToast.Show("인스펙터 실행 실패");
      } else {
        logger.d("AdMob: 애드 인스펙터 실행 성공");
      }
    });
  }

  /// 서버에서 받은 광고 로드
  Future<Advertisement?> fetchBanner(ADType type) async {
    // 팝업을 띄울 때마다 항상 최신 상태를 서버에서 가져옴
    await syncAdmobInfoWithServer();

    Advertisement? getAd() {
      switch (type) {
        case ADType.dailyWorkStampPopupBanner:
          return bannerData.dailyDetailBannerAd;
        case ADType.caseCoupangBottomBanner:
          return bannerData.caseCoupangBottomBannerAd;
        case ADType.caseNotCoupangCenterBanner:
          return bannerData.caseNotCoupangCenterBannerAd;
      }
    }

    return getAd();
  }

  /// 서버에서 adUnitId를 직접 받는 배너 광고
  BannerADController bannerControllerByUnitID({
    required String adUnitId,
    required AdSize bannerSize,
    required String transactionID,
    bool forceShow = false,
  }) {
    return BannerADController(
      adUnitId: adUnitId,
      bannerSize: bannerSize,
      targetChecker: AppNotifier.instance,
      transactionID: transactionID,
      forceShow: forceShow,
    );
  }

  /// 서버에서 adUnitId를 직접 받는 보상형 광고 (PrepareRewardAdResponse 기반)
  RewardedADController rewardedControllerByUnitID({
    required String adUnitID,
    required String transactionID,
    required String customData,
    bool forceShow = false,
  }) {
    return RewardedADController(
      adUnitID: adUnitID,
      transactionID: transactionID,
      customData: customData,
      targetChecker: AppNotifier.instance,
      forceShow: forceShow,
    );
  }

  /// 일반 전면 광고 컨트롤러
  InterstitialADController interstitialControllerByUnitID({
    required String adUnitID,
    required String transactionID,
    bool forceShow = false,
  }) {
    return InterstitialADController(
      adUnitID: adUnitID,
      transactionID: transactionID,
      targetChecker: AppNotifier.instance,
      forceShow: forceShow,
    );
  }

  /// 보상형 전면 광고 컨트롤러
