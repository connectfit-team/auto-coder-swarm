      AppGrpcClient().User(token: token).changePassword,
      RequestChangePassword(
        excludeDeviceId: excludeDeviceID,
        password: password,
      ),
    ).perform();
  }

  @override
  Future<GrpcResponse<ResponseChangePasswordWithoutToken>>
      resetPasswordWithoutToken({
    required String excludeDeviceID,
    required String code,
    required String email,
    required String password,
  }) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().User().changePasswordWithoutToken,
      RequestChangePasswordWithoutToken(
        excludeDeviceId: excludeDeviceID,
        code: code,
        email: email,
        password: password,
      ),
    ).perform();
  }

  @override
  Future<GrpcResponse<ResponseCheckAuthenticationFixed>> checkAuthentication({
    required bool isGuest,
    required String deviceID,
    String? adID,
  }) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().User().checkAuthenticationFixed,
      RequestCheckAuthenticationFixed(
        isGuest: isGuest,
        deviceId: deviceID,
        adid: adID,
      ),
    ).perform();
  }

  @override
  Future<GrpcResponse<ResponseGetActiveExternalAdvertisement>>
      getActiveExternalAdvertisement() async {
    final env = IS_PROD
        ? Environment.ENVIRONMENT_PRODUCTION
        : Environment.ENVIRONMENT_STAGING;
    return await GrpcHandler.makeRequest(
      AppGrpcClient().AdvertisementService().getActiveExternalAdvertisement,
      RequestGetActiveExternalAdvertisement(environment: env),
    ).perform();
  }

  @override
  Future<GrpcResponse<ResponseGetCEOActiveExternalAdvertisement>>
      getCEOActiveExternalAdvertisement(String originID) async {
    final env = IS_PROD
        ? Environment.ENVIRONMENT_PRODUCTION
        : Environment.ENVIRONMENT_STAGING;
    return await GrpcHandler.makeRequest(
      AppGrpcClient().AdvertisementService().getCEOActiveExternalAdvertisement,
      RequestGetCEOActiveExternalAdvertisement(
        environment: env,
        originId: originID,
      ),
    ).perform();
  }

  @override
  Future<GrpcResponse<ResponseGetCoupangCozyProduct>> getCoupangCozyProduct({
    required String userID,
    required String adID,
    required String subID,
    required String size,
    required String? di,
  }) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().AdvertisementService().getCoupangCozyProduct,
      RequestGetCoupangCozyProduct(
        userId: userID,
        metadata: CoupangCozyMetadata(
          adId: adID,
          subId: subID,
          imageSize: size, // e.g., "80x80", "94x94", "200x200"
          di: di,
        ),
      ),
    ).perform();
  }

  @override
  Future<SocialAccess?> getSocialAccessInfo() async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().User().getSocialAccessInfo,
      RequestGetSocialAccessInfo(),
    ).perform();

    if (!resp.hasMessage || resp.hasError) {
      throw Exception("Failed to get social access info: ${resp.errorText}");
    }

    final message = resp.message!;
    return message.socialAccess;
  }
