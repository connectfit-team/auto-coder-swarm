      AppGrpcClient().WorkStamp(timeOut: timeOut).workStampLabelListGet,
      RequestWorkStampLabelListGet(workplaceId: workPlaceID),
    ).perform();
    if (resp.hasError) return Future.error(resp.errorText);
    final msg = resp.message!;
    final labels = msg.labels.map((e) => WorkLabel.fromProto(e)).toList();
    return {
      'synced': msg.synced,
      'labels': labels,
      'workPlaceID': workPlaceID,
    };
  }

  Future<List<WorkLabel>> syncWorkLabel(
      {required String workPlaceID,
      required List<WorkLabel> labels,
      Duration? timeOut}) async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().WorkStamp(timeOut: timeOut).workStampLabelSynchronize,
      RequestWorkStampLabelSynchronize(
        workplaceId: workPlaceID,
        labels: labels
            .map((label) => RequestWorkStampLabelSynchronize_Label(
                  label: label.label,
                  createdAt: Timestamp.fromDateTime(label.createdAt),
                ))
            .toList(),
      ),
    ).perform();
    if (resp.hasError) return Future.error(resp.errorText);
    final msg = resp.message!;
    return msg.labels
        .map((e) => WorkLabel(
              workPlaceID: workPlaceID,
              label: e.label,
              createdAt: DateTimeUtil.fromDateTime(e.createdAt.toDateTime()),
            ))
        .toList();
  }

  Future<bool> workLabelDelete(
      {required String workPlaceID,
