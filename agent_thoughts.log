// Dart imports:
import 'dart:async';

// Flutter imports:
import 'package:flutter/cupertino.dart';
import 'package:flutter/material.dart';
// Project imports:
import 'package:gig/firebase/firebase.message.dart';
import 'package:gig/gig.dart';
import 'package:gig/model/app_state.attendance.dart';
import 'package:gig/model/app_state.connect.dart';
import 'package:gig/model/app_state.dart';
import 'package:gig/model/common.dart';
import 'package:gig/model/team.dart';
import 'package:gig/model/user.dart';
import 'package:gig/model/user_property.dart';
import 'package:gig/model/work_place.dart';
import 'package:gig_mobile_proto/proto/ceo.message.proto.dart' as pb;
import 'package:gig_mobile_proto/proto/common/address.proto.dart';
import 'package:gig_mobile_proto/proto_v2/ceoapis/ceo/v1/proto.dart';
import 'package:gig_mobile_proto/proto_v2/policyapis/policy/v1/proto.dart';
import 'package:gig_mobile_proto/proto_v2/userapis/user/v1/proto.dart'
    hide Agreement;
// Package imports:
import 'package:provider/provider.dart';
import 'package:synchronized/synchronized.dart';

Future<void> syncPushAgreementIfNeeded(
  AppModel model, {
  Agreement? agreement,
}) async {
  try {
    final ag = agreement ?? await model.userAPI.getAgreement();

    if (ag.pointServicePush.agreed &&
        !model.user.hasPushType(model.user.push_types, UserPushType.reward)) {
      model.user.addPushType(UserPushType.reward);
    }
  } catch (e) {
    logger.e("Failed to sync push agreement: $e");
  }
}

final Lock checkAuthLock = Lock();
Future<void> checkAuth(BuildContext context) async {
  final model = context.read<AppModel>();
  if (model.user.invalid) {
    await syncPushAgreementIfNeeded(model);
    return;
  }

  final accessData = AccessData(
    deviceId: await APP_DEVICE_ID,
    os: Common.platformOS,
    model: await Common.deviceModel,
    version: await APP_VERSION,
    appId: await APP_PACKAGE_NAME,
    buildNumber: await APP_BUILD_NUMBER,
    fcmToken: await FirebaseMessage.fcmToken,
  );

  final resp = await model.userAPI.isAuthenticated(
    isGuest: model.isGuest,
    afterSignIn: appSession == AppSession.signIn,
    accessData: accessData,
    adID: Common.adID,
  );
  if (resp.hasError || !resp.hasMessage) {
    logger.e("========== CHECK AUTH ERROR  ${resp.errorText}");
    await _checkAuthWithoutToken(context, model);
    if (IS_CEO) {
      await model.initCeo(remote: true);
      if (model.ceo == null) return;
      await model.updateCEOEmail();
    }
    return;
  }

  final message = resp.message!;
  final agreement = message.agreement;
  final token = message.token;
  final result = message.result;
  final ceoActives = message.allCeoInfo;
  final countryCode = message.countryCode;
  AppNotifier.instance.setCountryCode(countryCode);

  switch (result) {
    case AuthenticateResultType.AUTHENTICATE_RESULT_TYPE_SUCCESS:
      await syncPushAgreementIfNeeded(model, agreement: agreement);
      await _checkAuthWithToken(context, model, token);
    case AuthenticateResultType
          .AUTHENTICATE_RESULT_TYPE_SUCCESS_NEED_FCM_REFRESH:
      await FirebaseMessage.refreshFcmToken();
      await model.userAPI.updateFCMToken(
        token: token,
        deviceID: await APP_DEVICE_ID,
        fcmToken: await FirebaseMessage.fcmToken,
      );
      await _checkAuthWithToken(context, model, token);
    case AuthenticateResultType
          .AUTHENTICATE_RESULT_TYPE_FAILED_INVALID_ACCESS_DATA:
    case AuthenticateResultType.AUTHENTICATE_RESULT_TYPE_FAILED_DELETED_ACCOUNT:
    case AuthenticateResultType.AUTHENTICATE_RESULT_TYPE_FAILED_DELETED_DEVICE:
      await _checkAuthError(context, model, result);
    default:
      await _checkAuthWithoutToken(context, model);
  }

  if (IS_CEO) {
    await _setCEO(
      model: model,
      ceoActives: ceoActives,
    );
  }
}

Future<void> _checkAuthError(
    BuildContext context, AppModel model, AuthenticateResultType result) async {
  if (model.isGuest) return;
  logger.e("CHECK AUTH ERROR ${result.name}");
  await model.signOut(reason: result.name);
  await ConnectModel.instance.clear();
  await AttendanceModel.instance.clear();
  await AppRoutes.ToSplash(context: rootContext);
}

Future<void> _checkAuthWithToken(
    BuildContext context, AppModel model, String token) async {
  await _checkAuthSuccess(
    context: context,
    model: model,
    token: token,
  );
}

Future<void> _checkAuthWithoutToken(
    BuildContext context, AppModel model) async {
  await _checkAuthSuccess(
    context: context,
    model: model,
  );
}

Future<void> _checkAuthSuccess({
  required BuildContext context,
  required AppModel model,
  String? token,
}) async {
  checkAuthLock.synchronized(() async {
    appSession = AppSession.normal;
    if (token != null) model.user.token = token;
    await model.user.saveLocally();
    if (context.mounted) model.setUser(model.user);

    Future.delayed(Duration.zero, () async {
      await WorkPlaceSync.execute;
    });

    Future.delayed(Duration.zero, () async {
      final t = await Team.initSubscription;
      if (t) {
        await model.initTeams();
        await model.initWorkPlaces();
        if (!context.mounted) return;
        AppModel.NotifiyListener();
      }
    });
  });
}

Future<void> _setCEO({
  required AppModel model,
  required List<CEOActive> ceoActives,
}) async {
  if (ceoActives.isEmpty) return;
  pb.CEO? ceo;
  List<pb.CEO> trades = ceoActives.map(fromCEOActive).toList();
  if (trades.isEmpty) return;
  model.trades = trades;
  ceo ??= trades.first;
  model.user.id = ceo.migrateUser;
  await model.user.saveLocally();
  model.setUser(model.user);
  model.setCEO(ceo);
  await model.updateCEOEmail();
  final userIDs = trades.map((t) => t.migrateUser).toSet();
  userIDs.add(ceo.migrateUser);
  await UserProperty.SetProperty("ceo_userIDs", userIDs.join(","),
      remote: false);
  await model.setFilteredViewOrderWhenTradeChange();
}

pb.CEO fromCEOActive(CEOActive ceoActive) {
  return pb.CEO(
    id: ceoActive.id,
    email: ceoActive.email,
    name: ceoActive.name,
    createdAt: DateTimeUtil.fromDateTime(ceoActive.createdAt.toDateTime())
        .secondsSinceEpoch(),
    accessedAt: DateTimeUtil.fromDateTime(ceoActive.accessedAt.toDateTime())
        .secondsSinceEpoch(),
    tradeName: ceoActive.tradeName,
    phoneNumber: ceoActive.phoneNumber,
    migrateUser: ceoActive.migratedUser,
    imageUrl: ceoActive.imageUrl,
    address: ceoActive.hasAddress()
        ? Address(
            codeAddress: ceoActive.address.codeAddress,
            addressCategory: ceoActive.address.addressCategory,
            legacyAddress: ceoActive.address.legacyAddress,
            loadAddress: ceoActive.address.loadAddress,
            zipCode: ceoActive.address.zipCode,
            sido: ceoActive.address.sido,
            sigungu: ceoActive.address.sigungu,
            townAddress: ceoActive.address.townAddress,
            detailAddress: ceoActive.address.detailAddress,
            id: ceoActive.address.id,
          )
        : null,
    businessNumber: ceoActive.businessNumber,
  );
}


