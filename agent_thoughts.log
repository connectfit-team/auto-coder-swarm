    String otherText,
  ) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().User().accountDelete,
      user_commu_pb.RequestAccountDelete(
        reasonTypes: reasonTypes,
        otherText: otherText,
      ),
    ).perform();
  }

