[Technical Instructions]
1. Implement a pre-execution check for internet connectivity using IS_INTERNET_CONNECTED. 2. Wrap the execution logic using lock(synchronized) to prevent race conditions. 3. Implement recursive retry logic for AppError based on maxRetryCount and retryDelay. 4. Centralize error handling to use GigToast for global errors or the provided onError callback for specific cases.

[Original Code: /tmp/swarm_ws_da752fb8-33cb-4487-abbd-9a2bddb6bd17/repo/lib/rpc/api.executor.dart]
import 'package:easy_localization/easy_localization.dart';
import 'package:flutter/material.dart';
import 'package:gig_mobile_core/components/toast.dart';
import 'package:gig/gig.dart';
import 'package:gig/rpc/client.dart';
import 'package:synchronized/synchronized.dart';

class ApiExecutor {
  ApiExecutor._();
  static final instance = ApiExecutor._();

  final Map<String, Lock> _locks = {};
  Lock lock(String key) {
    _locks.putIfAbsent(key, () => Lock());
    return _locks[key]!;
  }

  Future<T> run<T>({
    required BuildContext context,
    required Future<T> Function() request,
    Function(String)? onError,
    String? synchronized,
    bool showToast = true,
    int maxRetryCount = 0,
    int retryCount = 0,
    Duration retryDelay = const Duration(seconds: 1),
  }) async {
    try {
      if (await IS_INTERNET_CONNECTED == false) {
        throw BusinessError("인터넷 연결을 확인해주세요".tr());
      }
      return synchronized != null
          ? await lock(synchronized).synchronized(request)
          : await request();
    } on AppError catch (e) {
      if (retryCount < maxRetryCount) {
        return await Future.delayed(retryDelay, () {
          return run<T>(
            context: context,
            request: request,
            onError: onError,
            synchronized: synchronized,
            maxRetryCount: maxRetryCount,
            retryCount: retryCount + 1,
            retryDelay: retryDelay,
          );
        });
      }
      if (onError == null) {
        GigToast.show(
          context: context,
          type: ToastType.warning,
          message: e.errorText,
        );
      } else {
        onError.call(e.errorText);
      }
      rethrow;
    } catch (e) {
      if (showToast) {
        GigToast.show(
          context: context,
          type: ToastType.warning,
          message: "오류가 계속되면 관리자에게 문의해주세요".tr(),
        );
      }
      rethrow;
    }
  }
}

