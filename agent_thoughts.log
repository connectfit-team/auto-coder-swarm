class MockRewardedController extends AdvertisementRewardedController {
  bool requestResult = true;
  bool showResult = true;
  bool rewardedStatus = false;
  bool rewardUsed = false;

  @override
  Future<bool> show(BuildContext context) async => showResult;

  @override
  Future<bool> request() async => requestResult;

  @override
  Future<bool> getIsRewarded() async => rewardedStatus;

  @override
  Future<void> useRewarded() async {
    rewardUsed = true;
  }
}

class MockInterstitialController extends AdvertisementInterstitialController {
  bool requestResult = true;
  bool showResult = true;

  @override
  Future<bool> show(BuildContext context) async => showResult;

  @override
  Future<bool> request() async => requestResult;
}

class MockBannerController extends AdvertisementBannerController {
  BannerAd? fakeAd;

  @override
  Future<BannerAd?> load() async {
    isRequested = true;
    banner.value = fakeAd;
    return fakeAd;
  }

  @override
  void deleteBannerAd() {
    banner.value = null;
    isRequested = false;
  }
