  /// Handles the authentication flow.
  /// Verifies if the user is authenticated, considering whether they are a guest
  /// or signing in, and utilizes the provided access data.
  @override
  Future<GrpcResponse<ResponseAuthenticateFixed>> isAuthenticated({
    required bool isGuest,
    required bool afterSignIn,
    required AccessData accessData,
    String? adID,
  }) async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().User().authenticateFixed,
      RequestAuthenticateFixed(
        isGuest: isGuest,
        afterSignIn: afterSignIn,
        accessData: accessData,
        adid: adID,
      ),
    ).perform();
    return resp;
  }

  /// Initiates phone number verification by sending a verification code to the provided [phoneNumber].
  @override
  Future<GrpcResponse<ResponseSendVerificationCode>> sendVerifyCode(
      String phoneNumber) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().User().sendVerificationCode,
      user_commu_pb.RequestSendVerificationCode(
        phoneNumber: phoneNumber.trim(),
        countryCode: "",
      ),
    ).perform();
  }

  /// Verifies the verification code sent to the [phoneNumber] to complete the phone number verification process.
  @override
  Future<GrpcResponse<ResponseCheckVerificationCode>> checkVerifyCode(
      String phoneNumber, String verifyCode) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().User().checkVerificationCode,
      user_commu_pb.RequestCheckVerificationCode(
        phoneNumber: phoneNumber,
        code: verifyCode,
        countryCode: "",
      ),
    ).perform();
  }

  /// Updates the user's profile information.
  /// If the update is successful, it returns a new authentication token to facilitate token renewal.
  @override
  Future<String?> updateUser({
    required String token,
    required user.User user,
  }) async {
    final headers = <String, String>{};
    headers['authorization'] = token;
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().User(headers: headers).userUpdate,
      user_commu_pb.RequestUserUpdate(
        name: user.name,
        gender: user.gender,
        birthYear: user.birth_year == null ? 0 : user.birth_year!.year,
        birthDate: user.birthDate == null
            ? Int64(0)
            : user.birthDate!.secondsSinceEpoch(),
        phoneNumber: user.phoneNumber,
        bankCode: user.bankCode,
        accountNumber: user.accountNumber,
        registrationNumber: user.requestAESRegistrationNumber,
        address: user.address,
        deviceId: await APP_DEVICE_ID,
        deviceExecutedAt: Timestamp.fromDateTime(DateTime.now()),
        email: user.email,
      ),
    ).perform();
    if (resp.hasError || !resp.hasMessage) {
      throw Exception('Failed to update profile: ${resp.errorText}');
    }
    final newToken = resp.message!.token;
    return newToken;
  }

