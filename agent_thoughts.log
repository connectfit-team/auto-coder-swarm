class SalaryAPI implements SalaryRepo {

  @override
  Future<GrpcResponse<CalculateSalaryTotalListResponse>>
      calculateSalaryTotalList(
          List<CalculateSalaryTotalListRequest_Request> requests) async {
    return GrpcHandler.makeRequest(
      AppGrpcClient().SalaryService().calculateSalaryTotalList,
      CalculateSalaryTotalListRequest(
        requests: requests,
      ),
    ).perform();
  }

  @override
  Future<GrpcResponse<CalculateSalaryStatisticResponse>> calculateSalaryStatistic({
    required DateTimeUtil targetDate,
    required DateTimeUtil exceptMonth,
    required List<CalculateSalaryStatisticRequest_Request> requests,
    required DateTimeUtil startDate,
    required DateTimeUtil endDate,
    bool withTax = true,
    bool withHoliday = true,
    List<WorkTag> tags = const [],
    List<WorkType> types = const [],
    List<Weekday> weekdays = const [],
  }) async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().SalaryService().calculateSalaryStatistic,
      CalculateSalaryStatisticRequest(
        targetDate: Timestamp.fromDateTime(targetDate),
        exceptMonth: Timestamp.fromDateTime(exceptMonth),
        requests: requests,
        totalFilter: Filter(
          period: pb.DateRange(
            start: Timestamp.fromDateTime(startDate),
            end: Timestamp.fromDateTime(endDate),
          ),
          withTax: withTax,
          withHoliday: withHoliday,
          tags: tags.map((e) => e.asProto).toList(),
          types: types.map((e) => e.toStampPB).toList(),
          weekdays: weekdays.map((e) => e.asProto).toList(),
        ),
      ),
    ).perform();
    return resp;
  }

  @override
  Future<GrpcResponse<CalculateMonthlySalaryDifferenceResponse>> calculateMonthlySalaryDiff({
    required List<CalculateMonthlySalaryDifferenceRequest_Request> requests,
    required DateTimeUtil startDate,
    required DateTimeUtil endDate,
    bool withTax = true,
    bool withHoliday = true,
    List<WorkTag> tags = const [],
    List<WorkType> types = const [],
    List<Weekday> weekdays = const [],
  }) async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().SalaryService().calculateMonthlySalaryDifference,
      CalculateMonthlySalaryDifferenceRequest(
        requests: requests,
        filter: Filter(
          period: pb.DateRange(
            start: Timestamp.fromDateTime(startDate),
            end: Timestamp.fromDateTime(endDate),
          ),
          withTax: withTax,
          withHoliday: withHoliday,
          tags: tags.map((e) => e.asProto).toList(),
          types: types.map((e) => e.toStampPB).toList(),
          weekdays: weekdays.map((e) => e.asProto).toList(),
        ),
      ),
    ).perform();
    return resp;
  }
}


