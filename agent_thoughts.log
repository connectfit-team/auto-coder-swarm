  @override
  Future<List<String>> isUnSynced({required List<String> workPlaceIDs}) async {
    final List<String> unSynced = [];
    final checkResponse = await AppGrpcClient()
        .WorkStamp()
        .workDaySynchronizationCheck(
            RequestWorkDaySynchronizationCheck(workplaceIds: workPlaceIDs));
    for (var status in checkResponse.statuses) {
      if (status.synced && workPlaceIDs.contains(status.workplaceId)) continue;
      unSynced.add(status.workplaceId);
    }
    return unSynced;
  }

  @override
  Future<void> synchronize({
    required String workPlaceID,
    required List<WorkStamp> workStamps,
  }) async {
    StreamController<RequestWorkDaySynchronize> requestStreamController =
        StreamController.broadcast(sync: false);
    const chunkSize = 1000;
    final resp = AppGrpcClient()
        .WorkStamp()
        .workDaySynchronize(requestStreamController.stream);
    requestStreamController.onListen = () {
      if (workStamps.length <= chunkSize) {
        requestStreamController.add(RequestWorkDaySynchronize(
          workplaceId: workPlaceID,
          workStamps: workStamps.map((e) => e.toProto).toList(),
        ));
      } else {
        while (workStamps.length >= chunkSize) {
          requestStreamController.add(RequestWorkDaySynchronize(
            workplaceId: workPlaceID,
            workStamps:
                workStamps.sublist(0, chunkSize).map((e) => e.toProto).toList(),
          ));
          workStamps.removeRange(0, chunkSize);
        }
        requestStreamController.add(RequestWorkDaySynchronize(
          workplaceId: workPlaceID,
          workStamps: workStamps.map((e) => e.toProto).toList(),
        ));
      }
      requestStreamController.add(RequestWorkDaySynchronize(
        workplaceId: workPlaceID,
        workStamps: [],
      ));
    };
    try {
      await AppGrpcClient().WorkStamp().workQuickDaySynchronize(
          RequestWorkQuickDaySynchronize(workplaceIds: [workPlaceID]));
    } catch (e) {}
  }

