      CalculateMonthlySalaryDifferenceRequest(
        requests: requests,
        filter: Filter(
          period: pb.DateRange(
            start: Timestamp.fromDateTime(startDate),
            end: Timestamp.fromDateTime(endDate),
          ),
          withTax: withTax,
          withHoliday: withHoliday,
          tags: tags.map((e) => e.asProto).toList(),
          types: types.map((e) => e.toStampPB).toList(),
          weekdays: weekdays.map((e) => e.asProto).toList(),
