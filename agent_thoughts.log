  /// Retrieves the user agreement.
  /// The specific agreement fetched (Worker or CEO) depends on the [IS_WORKER] permission flag.
  @override
  Future<Agreement> getAgreement() async {
    final resp = await GrpcHandler.makeRequest(
      IS_WORKER
          ? AppGrpcClient().Policy().getWorkerAgreement
          : AppGrpcClient().Policy().getCEOAgreement,
      GetAgreementRequest(),
    ).perform();
    if (!resp.hasMessage || resp.hasError) {
      logger.e("getAgreement error: ${resp.errorText}");
      throw resp.throwError();
    }
    return resp.message!.agreement;
  }

  @override
  Future<Agreement> updateAgreement(List<AgreementUpdateItem> items) async {
    final resp = await GrpcHandler.makeRequest(
      IS_WORKER
          ? AppGrpcClient().Policy().updateWorkerAgreement
          : AppGrpcClient().Policy().updateCEOAgreement,
      UpdateAgreementRequest(items: items),
    ).exec();
    return resp.agreement;
  }

