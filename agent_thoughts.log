    ).perform();
    if (resp.hasError) return Future.error(resp.errorText);
    final msg = resp.message!;
    final stamps = WorkDayLegacy().convertWorkDay(msg.workDays);
    stamps.addAll(WorkDayLegacy().convertWorkDayCase(msg.workDayCases));
    return stamps;
