/// for ad configurations and state across the entire application, preventing 
/// multiple initialization calls and inconsistent ad data.
class AdmobManager {
  static final AdmobManager _singleton = AdmobManager._internal();
  static AdmobManager get instance => _singleton;
  AdmobManager._internal();

