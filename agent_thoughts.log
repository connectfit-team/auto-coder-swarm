  /// Handles the authentication flow to verify the user's identity.
  /// Supports guest access and post-sign-in authentication using [accessData].
  @override
  Future<GrpcResponse<ResponseAuthenticateFixed>> isAuthenticated({
    required bool isGuest,
    required bool afterSignIn,
    required AccessData accessData,
    String? adID,
  }) async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().User().authenticateFixed,
      RequestAuthenticateFixed(
        isGuest: isGuest,
        afterSignIn: afterSignIn,
        accessData: accessData,
        adid: adID,
