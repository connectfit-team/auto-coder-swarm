    as user_commu_pb;

import 'package:gig_mobile_proto/proto_v2/userapis/user/v1/proto.dart' as user_msg_pb;

import 'package:gig/rpc/client.dart';
import 'package:gig/gig.dart';
import 'package:grpc/grpc.dart';

class UserAPI implements UserRepo {
  @override
  Future<GrpcResponse<ResponseAuthenticateFixed>> isAuthenticated({
    required bool isGuest,
    required bool afterSignIn,
    required AccessData accessData,
    String? adID,
  }) async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().User().authenticateFixed,
      RequestAuthenticateFixed(
        isGuest: isGuest,
        afterSignIn: afterSignIn,
        accessData: accessData,
        adid: adID,
      ),
    ).perform();
    return resp;
  }

  @override
  Future<GrpcResponse<ResponseSendVerificationCode>> sendVerifyCode(
      String phoneNumber) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().User().sendVerificationCode,
      user_commu_pb.RequestSendVerificationCode(
        phoneNumber: phoneNumber.trim(),
        countryCode: "",
      ),
    ).perform();
  }

  @override
  Future<GrpcResponse<ResponseCheckVerificationCode>> checkVerifyCode(
      String phoneNumber, String verifyCode) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().User().checkVerificationCode,
      user_commu_pb.RequestCheckVerificationCode(
        phoneNumber: phoneNumber,
        code: verifyCode,
        countryCode: "",
      ),
    ).perform();
  }

  @override
  Future<String?> updateUser({
    required String token,
    required user.User user,
  }) async {
    final headers = <String, String>{};
    headers['authorization'] = token;
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().User(headers: headers).userUpdate,
      user_commu_pb.RequestUserUpdate(
        name: user.name,
        gender: user.gender,
        birthYear: user.birth_year == null ? 0 : user.birth_year!.year,
        birthDate: user.birthDate == null
            ? Int64(0)
            : user.birthDate!.secondsSinceEpoch(),
        phoneNumber: user.phoneNumber,
        bankCode: user.bankCode,
        accountNumber: user.accountNumber,
        registrationNumber: user.requestAESRegistrationNumber,
        address: user.address,
        deviceId: await APP_DEVICE_ID,
        deviceExecutedAt: Timestamp.fromDateTime(DateTime.now()),
        email: user.email,
      ),
    ).perform();
    if (resp.hasError || !resp.hasMessage) {
      throw Exception('Failed to update profile: ${resp.errorText}');
    }
    final newToken = resp.message!.token;
    return newToken;
  }

  @override
  Future<GrpcResponse> deleteAccount(
    List<UserSignOutReasonType> reasonTypes,
    String otherText,
  ) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().User().accountDelete,
      user_commu_pb.RequestAccountDelete(
        reasonTypes: reasonTypes,
        otherText: otherText,
      ),
    ).perform();
  }

  @override
  Future<user_commu_pb.ResponseSignUpCEO> signUpCEO({
    required user_msg_pb.SignUpForm form,
    required String tradeName,
  }) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().User().signUpCEO,
      user_commu_pb.RequestSignUpCEO(
        form: form,
        tradeName: tradeName,
      ),
    ).exec();
  }

  @override
  Future<Agreement> getAgreement() async {
    final resp = await GrpcHandler.makeRequest(
      IS_WORKER
          ? AppGrpcClient().Policy().getWorkerAgreement
          : AppGrpcClient().Policy().getCEOAgreement,
      GetAgreementRequest(),
    ).perform();
    if (!resp.hasMessage || resp.hasError) {
      logger.e("getAgreement error: ${resp.errorText}");
      throw resp.throwError();
    }
    return resp.message!.agreement;
  }

  @override
  Future<Agreement> updateAgreement(List<AgreementUpdateItem> items) async {
    final resp = await GrpcHandler.makeRequest(
      IS_WORKER
          ? AppGrpcClient().Policy().updateWorkerAgreement
          : AppGrpcClient().Policy().updateCEOAgreement,
      UpdateAgreementRequest(items: items),
    ).exec();
    return resp.agreement;
  }

  @override
  Future<List<pb_alarm.Alarm>> getAlarmList() async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().App().alarmList,
      AlarmRequest(),
    ).perform();
    if (resp.hasError) throw resp.throwError();
    return resp.message!.alarms;
  }

  @override
  Future<GrpcResponse<user_commu_pb.ResponsePrepareSignUpCEOFromWorker>>
      prepareSignUpCEOFromWorker() async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().User().prepareSignUpCEOFromWorker,
      user_commu_pb.RequestPrepareSignUpCEOFromWorker(),
    ).perform();
    return resp;
  }

  @override
  Future<GrpcResponse<user_commu_pb.ResponseSignUpCEOFromWorker>>
      signUpCEOFromWorker({
    required user_msg_pb.SignUpForm form,
    required String tradeName,
  }) async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().User().signUpCEOFromWorker,
      user_commu_pb.RequestSignUpCEOFromWorker(
        signUpForm: form,
        tradeName: tradeName,
      ),
    ).perform();
    return resp;
  }

  @override
  Future<String?> updateCEOProfile({
    required String email,
    required String phoneNumber,
    required String name,
  }) async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().User().updateCEOProfile,
      user_commu_pb.RequestUpdateCEOProfile(
        email: email,
        phone: phoneNumber,
        name: name,
      ),
    ).perform();
    if (resp.hasError || !resp.hasMessage) return null;
    final newToken = resp.message!.token;
    return newToken;
  }

  @override
  Future<GrpcResponse<ResponseGetAdvertisementList>> getAdvertisement({
    required Environment environment,
    required Target target,
    required Position position,
  }) async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().AdvertisementService().getAdvertisementList,
      RequestGetAdvertisementList(
        environment: environment,
        target: target,
        position: position,
      ),
    ).perform();
    return resp;
  }

  @override
  Future<GrpcResponse<ResponseCountAdvertisement>> getAdvertisementCount({
    required Environment environment,
    required Target target,
    required Position position,
  }) async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().AdvertisementService().countAdvertisement,
      RequestCountAdvertisement(
        environment: environment,
        target: target,
        position: position,
      ),
    ).perform();
    return resp;
  }

  @override
  Future<GrpcResponse<ResponseListMonthlyMemoExistence>> getMonthlyMemo({
    required String startDate,
    required String endDate,
    String? requestDate,
  }) async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().User().listMonthlyMemoExistence,
      RequestListMonthlyMemoExistence(
        startDate: startDate,
        endDate: endDate,
        requestDate: requestDate,
      ),
    ).perform();
    return resp;
  }

  @override
  Future<void> updateMonthlyMemo({
    required String targetDate,
    required String content,
  }) async {
    await GrpcHandler.makeRequest(
      AppGrpcClient().User().updateMonthlyMemo,
      RequestUpdateMonthlyMemo(
        targetDate: targetDate,
        content: content,
      ),
    ).exec();
  }

  @override
  Future<List<AppNotice>> getNotices() async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().App().appNoticeShowListGet,
      RequestAppNoticeShowListGet(),
    ).exec();
    return resp.notices;
  }

  @override
  Future<List<AccessDevice>> getAccessDevices() async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().User().listAccessDevice,
      RequestListAccessDevice(),
    ).exec();
    return resp.accessDevices;
  }

  @override
  Future<GrpcResponse<ResponseDeleteAccessDevice>> deleteAccessDevice(
      String deviceID) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().User().deleteAccessDevice,
      RequestDeleteAccessDevice(deviceId: deviceID),
    ).perform();
  }

  @override
  Future<GrpcResponse<ResponseSignOut>> signOut({
    required String deviceID,
    String? reason,
  }) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().User().signOut,
      RequestSignOut(
        deviceId: deviceID,
        case_2: reason,
      ),
    ).perform();
  }

  @override
  Future<GrpcResponse<ResponseUpdateFCMToken>> updateFCMToken({
    required String token,
    required String deviceID,
    required String fcmToken,
  }) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().User(token: token).updateFCMToken,
      RequestUpdateFCMToken(
        deviceId: deviceID,
        fcmToken: fcmToken,
      ),
    ).perform();
  }

  @override
  Future<GrpcResponse<ResponseSendChangePasswordEmailCode>>
      sendResetPasswordEmailCode({
    required String email,
    required String appID,
    required String version,
  }) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().User().sendChangePasswordEmailCode,
      RequestSendChangePasswordEmailCode(
        email: email,
        appId: appID,
        version: version,
      ),
    ).perform();
  }

  @override
  Future<GrpcResponse<ResponseCheckChangePasswordEmailCode>>
      checkResetPasswordEmailCode({
    required String email,
    required String code,
    required isSignIn,
  }) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().User().checkChangePasswordEmailCode,
      RequestCheckChangePasswordEmailCode(
        email: email,
        code: code,
        isSignIn: isSignIn,
      ),
    ).perform();
  }

  @override
  Future<GrpcResponse<ResponseChangePassword>> resetPassword({
    required String excludeDeviceID,
    required String password,
    required String token,
  }) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().User(token: token).changePassword,
      RequestChangePassword(
        excludeDeviceId: excludeDeviceID,
        password: password,
      ),
    ).perform();
  }

  @override
  Future<GrpcResponse<ResponseChangePasswordWithoutToken>>
      resetPasswordWithoutToken({
    required String excludeDeviceID,
    required String code,
    required String email,
    required String password,
  }) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().User().changePasswordWithoutToken,
      RequestChangePasswordWithoutToken(
        excludeDeviceId: excludeDeviceID,
        code: code,
        email: email,
        password: password,
      ),
    ).perform();
  }

  @override
  Future<GrpcResponse<ResponseCheckAuthenticationFixed>> checkAuthentication({
    required bool isGuest,
    required String deviceID,
    String? adID,
  }) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().User().checkAuthenticationFixed,
      RequestCheckAuthenticationFixed(
        isGuest: isGuest,
        deviceId: deviceID,
        adid: adID,
      ),
    ).perform();
  }

  @override
  Future<GrpcResponse<ResponseGetActiveExternalAdvertisement>>
      getActiveExternalAdvertisement() async {
    final env = IS_PROD
        ? Environment.ENVIRONMENT_PRODUCTION
        : Environment.ENVIRONMENT_STAGING;
    return await GrpcHandler.makeRequest(
      AppGrpcClient().AdvertisementService().getActiveExternalAdvertisement,
      RequestGetActiveExternalAdvertisement(environment: env),
    ).perform();
  }

  @override
  Future<GrpcResponse<ResponseGetCEOActiveExternalAdvertisement>>
      getCEOActiveExternalAdvertisement(String originID) async {
    final env = IS_PROD
        ? Environment.ENVIRONMENT_PRODUCTION
        : Environment.ENVIRONMENT_STAGING;
    return await GrpcHandler.makeRequest(
      AppGrpcClient().AdvertisementService().getCEOActiveExternalAdvertisement,
      RequestGetCEOActiveExternalAdvertisement(
        environment: env,
        originId: originID,
      ),
    ).perform();
  }

  @override
  Future<GrpcResponse<ResponseGetCoupangCozyProduct>> getCoupangCozyProduct({
    required String userID,
    required String adID,
    required String subID,
    required String size,
    required String? di,
  }) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().AdvertisementService().getCoupangCozyProduct,
      RequestGetCoupangCozyProduct(
        userId: userID,
        metadata: CoupangCozyMetadata(
          adId: adID,
          subId: subID,
          imageSize: size, // e.g., "80x80", "94x94", "200x200"
          di: di,
        ),
      ),
    ).perform();
  }

  @override
  Future<SocialAccess?> getSocialAccessInfo() async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().User().getSocialAccessInfo,
      RequestGetSocialAccessInfo(),
    ).perform();

    if (!resp.hasMessage || resp.hasError) {
      throw Exception("Failed to get social access info: ${resp.errorText}");
    }

    final message = resp.message!;
    return message.socialAccess;
  }
