      final bannerBottom = manager.internalBannerADController(position: Position.BOTTOM);
      final popup = manager.internalPopupADController();

      expect(identical(bannerTop, bannerBottom), isFalse);
      expect(identical(bannerTop, popup), isFalse);
      expect(identical(bannerBottom, popup), isFalse);
      
      // Verify cached versions are still the same
      expect(identical(manager.internalBannerADController(position: Position.TOP), bannerTop), isTrue);
      expect(identical(manager.internalPopupADController(), popup), isTrue);
