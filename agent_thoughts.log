class UserAPI implements UserRepo {
  /// Handles the authentication flow to verify the user's identity.
  /// 
  /// This method is used to establish or validate a session. It distinguishes between
  /// a guest session ([isGuest] = true) and a registered user session.
  /// If [afterSignIn] is true, it handles the logic following a successful login
  /// process using the provided [accessData]. The [adID] is optionally passed for 
  /// advertising tracking/attribution.
  @override
  Future<GrpcResponse<ResponseAuthenticateFixed>> isAuthenticated({
    required bool isGuest,
    required bool afterSignIn,
    required AccessData accessData,
    String? adID,
  }) async {
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().User().authenticateFixed,
      RequestAuthenticateFixed(
        isGuest: isGuest,
        afterSignIn: afterSignIn,
        accessData: accessData,
        adid: adID,
      ),
    ).perform();
    return resp;
  }

  /// Triggers the sending of a verification code to the specified [phoneNumber].
  /// 
  /// The [phoneNumber] is trimmed to remove any leading or trailing whitespace before 
  /// being sent to the server. This is the initial step of the phone number verification 
  /// process used for identity confirmation via SMS.
  @override
  Future<GrpcResponse<ResponseSendVerificationCode>> sendVerifyCode(
      String phoneNumber) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().User().sendVerificationCode,
      user_commu_pb.RequestSendVerificationCode(
        phoneNumber: phoneNumber.trim(),
        countryCode: "",
      ),
    ).perform();
  }

  /// Verifies the [verifyCode] received by the user at the provided [phoneNumber].
  /// 
  /// This method validates the verification code sent previously via [sendVerifyCode].
  /// A successful response indicates that the user has ownership of the phone number,
  /// allowing the application to proceed with registration or identity verification.
  @override
  Future<GrpcResponse<ResponseCheckVerificationCode>> checkVerifyCode(
      String phoneNumber, String verifyCode) async {
    return await GrpcHandler.makeRequest(
      AppGrpcClient().User().checkVerificationCode,
      user_commu_pb.RequestCheckVerificationCode(
        phoneNumber: phoneNumber,
        code: verifyCode,
        countryCode: "",
      ),
    ).perform();
  }

  /// Updates the user's profile information.
  /// 
  /// This method sends updated user details (name, gender, birth date, etc.) to the server.
  /// A critical part of this flow is the token renewal logic: because profile updates may 
  /// change user permissions or session state, the server may return a renewed 
  /// authentication token in the response. 
  /// 
  /// The method returns the new token if provided by the server; otherwise, it returns null.
  @override
  Future<String?> updateUser({
    required String token,
    required user.User user,
  }) async {
    final headers = <String, String>{};
    headers['authorization'] = token;
    final resp = await GrpcHandler.makeRequest(
      AppGrpcClient().User(headers: headers).userUpdate,
      user_commu_pb.RequestUserUpdate(
        name: user.name,
        gender: user.gender,
        birthYear: user.birth_year == null ? 0 : user.birth_year!.year,
        birthDate: user.birthDate == null
            ? Int64(0)
            : user.birthDate!.secondsSinceEpoch(),
        phoneNumber: user.phoneNumber,
        bankCode: user.bankCode,
        accountNumber: user.accountNumber,
        registrationNumber: user.requestAESRegistrationNumber,
        address: user.address,
        deviceId: await APP_DEVICE_ID,
        deviceExecutedAt: Timestamp.fromDateTime(DateTime.now()),
        email: user.email,
      ),
    ).perform();
    if (resp.hasError || !resp.hasMessage) {
      throw Exception('Failed to update profile: ${resp.errorText}');
    }
    final newToken = resp.message!.token;
    return newToken;
  }

